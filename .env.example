# Copy to .env — never commit .env

# --- LLM (required for X6 / agent path) ---
USE_LLM=1
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local alternative:
# USE_LLM=1
# MODEL_PROVIDER=ollama
# MODEL_NAME=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434

# Rate-limit safety (free tiers ~15 rpm)
LLM_MIN_INTERVAL_SEC=2
LLM_MAX_RETRIES=5
LLM_MAX_AGENT_STEPS=12

# Set USE_LLM=0 to force offline rules-only demos
# USE_LLM=0
# MODEL_PROVIDER=none

OWNER_EMAIL=sam@paperjet.io
DRY_RUN=1
AUTO_APPROVE=0
